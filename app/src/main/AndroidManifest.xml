<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Own task so closing it reveals Instagram, not ReelBlock's main screen. -->
        <activity
            android:name=".BlockedActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.reelblock.blocked" />

        <!-- The blocker and its settings run in their own process, so clearing
             ReelBlock from Recents (which kills the UI process) leaves them running. -->
        <provider
            android:name=".PrefsProvider"
            android:authorities="com.reelblock.prefs"
            android:exported="false"
            android:process=":blocker" />

        <service
            android:name=".BlockerService"
            android:exported="false"
            android:process=":blocker"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/blocker_service" />
        </service>
    </application>
</manifest>
